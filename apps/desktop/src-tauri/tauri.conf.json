{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YoMeets",
  "version": "0.1.0",
  "identifier": "com.yomeets.local",
  "build": {
    "beforeDevCommand": "pnpm --filter @yomeets/cli dev",
    "frontendDist": "../",
    "devUrl": "http://127.0.0.1:47821"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YoMeets",
        "url": "index.html",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "center": true
      },
      {
        "label": "overlay",
        "title": "YoMeets Listening",
        "url": "overlay.html",
        "width": 72,
        "height": 72,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
